      <Placemark>
        <name>Gen Yamamoto</name>
        <description>This elegant speakeasy in Azabu-Juban is all about the art of the cocktail. Each drink is crafted with precision and care using only the freshest ingredients.</description>
        <styleUrl>#icon-1798-F57C00</styleUrl>
        <Point>
