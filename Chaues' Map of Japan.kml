          <coordinates>
            135.7709675,35.0040467,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>BEE’S KNEES</name>
        <styleUrl>#icon-1798-F57C00-nodesc</styleUrl>
        <Point>
          <coordinates>
            135.7702976,35.005012,0
